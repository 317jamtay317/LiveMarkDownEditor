<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:UI.Controls">

    <!-- Default style for the Folder Panel. Authored as the control's ResourceDictionary alongside the
         FolderPanel class, per the project's Control conventions. Colors are DynamicResource lookups
         into the active palette so the panel follows the light/dark theme. -->

    <!-- A tree-node glyph (a folder or a Markdown file): a small stroked icon that takes the row's
         foreground, so it recolors on the accent-filled selected row like a Command Icon. -->
    <Style x:Key="FolderTreeIcon" TargetType="Path">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke"
                Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>

    <!-- The Expand/Collapse chevron beside a Folder: pointing right (▸) when Collapsed, down (▾) when
         Expanded — the same convention as the Editor Gutter's Fold Toggle and the Outline's chevron. -->
    <Style x:Key="FolderTreeExpander" TargetType="ToggleButton">
        <Setter Property="Width" Value="16" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <TextBlock x:Name="Chevron" Text="&#x25B8;" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Text" Value="&#x25BE;" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One tree row: an Expand/Collapse chevron (hidden for a leaf), the row header, and the nested
         children indented beneath it. Hover and the accent-filled selection are keyed to the header
         Border alone (SourceName="Bd"), so hovering or selecting a child never lights up its ancestors. -->
    <Style x:Key="FolderTreeItem" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                      Style="{StaticResource FolderTreeExpander}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" />

                        <Border x:Name="Bd" Grid.Row="0" Grid.Column="1" Background="Transparent"
                                CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                              HorizontalAlignment="Left" />
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One Folder Panel Row: its folder / Markdown-file glyph and its name. A Folder's Children are the
         nested rows; a File has none, so its row shows no chevron. The icon switches on the row's kind,
         the same DataTrigger-on-Kind technique the Difference Overlay uses for a Difference Line. The
         rows are the panel's own, kept across rebuilds of the Folder Tree (INV-044).

         While a File's name is being edited for Rename File (INV-082), the name gives way to the name
         editor, which types into the row's NewName. The panel focuses it and handles Enter, Escape and
         focus leaving it; the editor is only the look. -->
    <HierarchicalDataTemplate x:Key="FolderTreeTemplate" DataType="{x:Type controls:FolderPanelRow}"
                              ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal">
            <Path x:Name="NodeIcon" Style="{StaticResource FolderTreeIcon}"
                  Data="{StaticResource Icon.Folder}" />
            <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <!-- The negative margin lets the editor's border and padding overlap the row's own padding,
                 so the row keeps its height and the rows below do not jump while a name is edited. -->
            <TextBox x:Name="NameEditor" Visibility="Collapsed" MinWidth="140" Padding="3,1"
                     Margin="-4,-3,0,-3"
                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource EditorBackgroundBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     CaretBrush="{DynamicResource TextBrush}"
                     SelectionBrush="{DynamicResource AccentBrush}"
                     BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                     AutomationProperties.AutomationId="FileNameEditor"
                     AutomationProperties.Name="New name" />
        </StackPanel>
        <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="File">
                <Setter TargetName="NodeIcon" Property="Data" Value="{StaticResource Icon.MarkdownFile}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                <Setter TargetName="NameText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="NameEditor" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <Style TargetType="{x:Type controls:FolderPanel}" BasedOn="{StaticResource {x:Type TreeView}}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FolderTreeItem}" />
        <Setter Property="ItemTemplate" Value="{StaticResource FolderTreeTemplate}" />

        <!-- The File context menu, holding Rename File (INV-082) and Delete File (INV-081). It belongs to
             the panel rather than to each row. Before it opens, the panel selects the right-clicked row
             when that row is a File, and stops the menu over a Folder or empty space. So each entry acts
             on the Selected Folder Entry, exactly as F2 and the Delete key do.

             A ContextMenu is its own visual tree, so it reaches the panel through PlacementTarget: the
             Rename entry routes the panel's own EditFileName command to it, and the Delete entry binds
             its DeleteCommand. Its styles are DynamicResource because a Setter's value is built as this
             dictionary loads, before the Controls.xaml dictionary that defines them can be seen from
             here. -->
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu Style="{DynamicResource TabContextMenu}">
                    <MenuItem Style="{DynamicResource CommandMenuEntry}" Header="Rename file"
                              AutomationProperties.Name="Rename file"
                              Command="{x:Static controls:FolderPanel.EditFileName}"
                              CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Style="{DynamicResource CommandMenuEntry}" Header="Delete file"
                              AutomationProperties.Name="Delete file"
                              Command="{Binding PlacementTarget.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedEntry, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
