<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:UI.Controls"
                    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <!-- Default style for the Video Player (INV-069). Authored as the control's ResourceDictionary
         alongside the VideoPlayerView class, per the project's Control conventions.

         Until the reader asks, the plate is all there is — the browser underneath has not been created,
         so an unwatched Video costs nothing and cannot play. Started, the plate goes and the video plays
         behind this control bar.

         The Play Toggle and the Scrubber are drawn here rather than by the browser because nothing inside
         this control can be clicked directly: the page is composition-hosted inside a RichTextBox, where
         a WPF hit-test at the video lands on nothing at all. The editor routes the click to the control,
         which decides between the two from where it landed — so what the reader sees answering their
         click is what is drawn here. -->

    <Style TargetType="{x:Type controls:VideoPlayerView}">
        <!-- No Width or Height here on purpose: the player takes the width the line offers and the
             height its video's shape calls for, so it never overhangs the text column's right margin
             while sitting flush with its left (see MeasureOverride). -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:VideoPlayerView}">
                    <Border BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True"
                            ClipToBounds="True" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}">
                        <DockPanel LastChildFill="True">
                            <!-- The control bar: the Play Toggle's glyph, the Scrubber, and the time. -->
                            <Grid DockPanel.Dock="Bottom" Height="30" Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path x:Name="PART_PlayToggle" Grid.Column="0" Width="10" Height="12"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      Fill="{DynamicResource TextBrush}" Data="M 0,0 L 12,7 L 0,14 Z" />

                                <!-- The Scrubber: its track is the part a click seeks within, so the
                                     control measures this element to turn an x into a position. -->
                                <ProgressBar x:Name="PART_Scrubber" Grid.Column="1" Height="4" Margin="10,0"
                                             Minimum="0" Maximum="1" BorderThickness="0" Focusable="False"
                                             IsHitTestVisible="False" VerticalAlignment="Center"
                                             Background="{DynamicResource BorderBrush}"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Value="{Binding Progress, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type controls:VideoPlayerView}}}" />

                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding ElapsedText, RelativeSource={RelativeSource AncestorType={x:Type controls:VideoPlayerView}}}" />
                            </Grid>

                            <!-- The picture, over a dark plate so the video's own edges read against it. -->
                            <Grid Background="#FF101114">
                                <!-- The composition-hosted control, not the plain WebView2. A plain one is
                                     a native child window: it draws on top of everything, so a Video
                                     scrolled to the bottom of the pane paints straight over the status
                                     bar. This one renders into the WPF visual tree, so the pane clips it
                                     and the chrome sits above it, as chrome must. -->
                                <wv2:WebView2CompositionControl x:Name="PART_Browser"
                                                                DefaultBackgroundColor="#101114" />

                                <!-- The still plate: what an unstarted Video looks like. Its play mark
                                     says the Video may be started and never that it already is. -->
                                <Border x:Name="PART_Plate" Background="#FF101114">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="#33FFFFFF"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Fill="#FFFFFFFF" Stretch="Uniform" Width="22" Height="22"
                                              Margin="6,0,0,0" Data="M 0,0 L 12,7 L 0,14 Z" />
                                    </Border>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Started once: the plate has nothing left to say, and the video surface it was
                             covering is what the reader came for. -->
                        <Trigger Property="HasStarted" Value="True">
                            <Setter TargetName="PART_Plate" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Playing: the Play Toggle becomes a pause bar, so the control shows what the
                             next click will do. -->
                        <Trigger Property="IsPlaying" Value="True">
                            <Setter TargetName="PART_PlayToggle" Property="Data"
                                    Value="M 0,0 L 4,0 L 4,14 L 0,14 Z M 8,0 L 12,0 L 12,14 L 8,14 Z" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
